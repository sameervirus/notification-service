NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
# Pretty-printed logs for local terminals. Leave false (or unset) everywhere else —
# the pino-pretty package is a devDependency and isn't in the production image.
LOG_PRETTY=true

DATABASE_URL=postgresql://notification_service:notification_service@localhost:5432/notification_service
REDIS_URL=redis://localhost:6379

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Notifications <no-reply@example.com>"

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# RSA public key the backend's JWTs are verified against (RS256). Run `npm run dev:keys`
# to generate a local dev keypair, then `npm run dev:token` to mint a test token.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER=notification-service-clients
JWT_AUDIENCE=notification-service

RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
