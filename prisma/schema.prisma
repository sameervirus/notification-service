generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  FAILED_PERMANENT
}

model Notification {
  id           String              @id @default(uuid())
  channel      NotificationChannel
  recipient    String
  template     String
  payload      Json
  status       NotificationStatus  @default(QUEUED)
  attempts     Int                 @default(0)
  providerUsed String?
  lastError    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status])
  @@map("notifications")
}

enum AuditEventType {
  AUTH_SUCCESS
  AUTH_FAIL
  SEND_ATTEMPT
  SEND_RESULT
}

model AuditLog {
  id             String         @id @default(uuid())
  eventType      AuditEventType
  notificationId String?
  actor          String?
  detail         Json
  createdAt      DateTime       @default(now())

  @@index([notificationId])
  @@index([eventType])
  @@map("audit_log")
}
