{
  "name": "notification-service",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-agnostic notification service (email/SMS) with queued delivery and audit logging",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "prisma migrate deploy && node dist/server.js",
    "start:worker": "prisma migrate deploy && node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "dev:keys": "tsx scripts/generate-dev-keypair.ts",
    "dev:token": "tsx scripts/mint-dev-token.ts"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^11.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bullmq": "^5.81.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.1.0",
    "ioredis": "^5.11.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^9.5.0",
    "prisma": "^7.9.1",
    "twilio": "^6.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "jsonwebtoken": "^9.0.3",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
